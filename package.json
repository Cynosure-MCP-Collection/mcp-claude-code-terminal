    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-claude-code-terminal.git"
    },
    "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-claude-code-terminal#readme",
