        "start": "node dist/index.js",
        "dev": "tsx src/index.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.1",
        "node-pty": "^1.1.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
