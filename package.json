{
    "name": "@cynosure-mcp/claude-code-terminal",
    "mcpName": "io.github.andreasjhagen/claude-code-terminal",
    "version": "1.0.1",
    "description": "MCP server for starting and controlling Claude Code CLI coding sessions",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "claude-code-terminal": "dist/index.js"
    },
